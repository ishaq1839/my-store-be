PORT=3000
ACCESS_TOKEN_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me
# Required for login (Firebase Auth email/password via Identity Toolkit)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
# Continue URL used in password-reset action links (must be an Authorized domain in Firebase Console)
PASSWORD_RESET_CONTINUE_URL=http://localhost:3000/reset-password
# Choose ONE of the following (env JSON is best for deployments):
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
# Or base64-encoded JSON (single-line, easy for env vars):
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
# Or in local dev, point to the JSON file you pasted:
FIREBASE_SERVICE_ACCOUNT_PATH=./firestore-keys.json

